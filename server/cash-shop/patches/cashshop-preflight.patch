+// A purchased plain item must be preflighted against the same stack pc_additem
+// will use. pc_checkadditem matches only nameid and can select a bound/rental or
+// card-marked stack, causing an incorrect slot/stack prediction before payment.
+static char cashshop_check_plain_item(const map_session_data* sd, const item_data& data, uint32 amount) {
+	if (amount > MAX_AMOUNT || (data.stack.inventory && amount > data.stack.amount))
+		return CHKADDITEM_OVERAMOUNT;
+	if (!itemdb_isstackable2(&data) || data.flag.guid)
+		return CHKADDITEM_NEW;
+	for (int i = 0; i < MAX_INVENTORY; ++i) {
+		const auto& item = sd->inventory.u.items_inventory[i];
+		if (item.nameid != data.nameid || item.bound || item.expire_time || item.unique_id) continue;
+		bool plain = true;
+		for (const auto card : item.card) if (card != 0) plain = false;
+		if (!plain) continue;
+		if (i >= sd->status.inventory_slots || amount > MAX_AMOUNT - item.amount ||
+			(data.stack.inventory && amount > data.stack.amount - item.amount))
+			return CHKADDITEM_OVERAMOUNT;
+		return CHKADDITEM_EXIST;
+	}
+	return CHKADDITEM_NEW;
+}
