+// Successful native RNG result is not acknowledged until a durable egg exists.
+bool catalogue_pet_capture(map_session_data& sd,mob_data& md) {
+    if(CheckForCharServer() || catalogue_pet::available(mmysql_handle)!=1 || pc_isdead(&sd) || sd.state.trading ||
+       sd.state.warping || sd.state.changemap || catalogue_pet_pending.count(sd.status.account_id) ||
+       companion_runtime::busy(sd.status.account_id) || companion_supplies::busy(sd.status.account_id))return false;
+    auto pet=pet_db.find(md.mob_id);if(!pet)return false;
+    auto egg_data=item_db.find(pet->EggID);auto mob=mob_db.find(pet->class_);
+    if(!egg_data || !mob || uint64(sd.weight)+egg_data->weight>sd.max_weight)return false;
+    catalogue_pet::Claim q{};q.capture=true;
+    q.account=sd.status.account_id;q.character=sd.status.char_id;q.capacity=sd.status.inventory_slots;
+    q.voucher_slot=-1;q.food_slot=-1;q.egg_slot=-1;
+    std::copy_n(sd.inventory.u.items_inventory,MAX_INVENTORY,q.before.begin());
+    for(int n=0;n<q.capacity;++n)if(!q.before[n].nameid){q.egg_slot=n;break;}
+    if(q.egg_slot<0)return false;
+    q.egg_id=pet->EggID;q.monster=pet->class_;q.level=mob->lv;q.intimacy=pet->intimate;
+    char name[NAME_LENGTH];safestrncpy(name,mob->jname.c_str(),NAME_LENGTH);q.name=name;
+    q.egg_card0=CARD0_PET;q.egg_card3=pet_get_card3_intimacy(pet->intimate);
+    if(!intif_storage_save(&sd,&sd.inventory))return false;
+    uint32 token=++catalogue_pet_sequence;
+    if(token<0x40000000 || token>=0x80000000)token=catalogue_pet_sequence=0x40000001;
+    int timer=add_timer(gettick()+10000,catalogue_pet_timeout,q.account,0);
+    catalogue_pet_pending.emplace(q.account,CataloguePetPending{q,token,timer,sd.fd,sd.login_id1,sd.m,md.id});
+    WFIFOHEAD(char_fd,14);WFIFOW(char_fd,0)=0x30af;WFIFOL(char_fd,2)=q.account;WFIFOL(char_fd,6)=q.character;WFIFOL(char_fd,10)=token;WFIFOSET(char_fd,14);
+    return true;
 }
 
