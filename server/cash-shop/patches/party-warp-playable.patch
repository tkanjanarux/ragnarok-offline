+// Giant Fly Wing / warpparty placement only. Follow/combat policy is unchanged.
+bool population_party_warp(map_session_data* sd, std::uint16_t mapindex, std::int16_t x, std::int16_t y) {
+    if (!population_m1_is_shell(sd)) return false;
+    const int16 map = map_mapindex2mapid(mapindex);
+    if (map < 0 || !map_getcell(map, x, y, CELL_CHKPASS)) return false;
+    if (!place_shell(sd, map, mapindex, x, y)) {
+        population_m1_release(sd); // Persist and reserve instead of leaving an invisible PC.
+        return false;
+    }
+    auto& shell = shells.at(sd->id);
+    shell.target = 0; shell.failures = 0;
+    return true;
+}
+
 companion_build::Build companion_build::active(const map_session_data* sd){
  auto it=shells.find(sd->id);return it==shells.end()?Build::legacy:it->second.build;
 }
