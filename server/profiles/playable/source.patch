+// Observation only: the counters below are never read by combat decisions.
+int kt_owner(const block_list* bl){
+ if(!bl)return 0;
+ for(const auto& kv:hunts){
+  const auto& h=kv.second;
+  if(h.mode!=TeamMode::mob)continue;
+  auto* owner=map_charid2sd(kv.first);
+  if(!owner || owner->m!=bl->m)continue;
+  if(bl->id==owner->id)return kv.first;
+  auto it=shells.find(bl->id);
+  if(it!=shells.end() && it->second.character==kv.first)return kv.first;
+  if(bl->type==BL_MOB && (distance_xy(bl->x,bl->y,h.x,h.y)<=26 || scout_sees(owner,bl)))return kv.first;
+ }
+ return 0;
+}
+namespace { struct AuditField {int owner,x,y;}; std::unordered_map<int, AuditField> audit_fields; }
+void kt_field(const s_skill_unit_group& g,bool begin,int x,int y){
+ if(g.skill_id!=WZ_STORMGUST)return;
+ auto it=audit_fields.find(g.group_id);
+ if(begin){
+  int cid=kt_owner(map_id2bl(g.src_id));if(!cid)return;
+  audit_fields[g.group_id]={cid,x,y};it=audit_fields.find(g.group_id);
+ }else if(it==audit_fields.end())return;
+ const auto data=it->second;auto team=hunts.find(data.owner);
+ Hunt* h=(team!=hunts.end() && team->second.mode==TeamMode::mob)?&team->second:nullptr;
+ if(begin && h){h->audit_group=g.group_id;h->audit_hits.clear();h->audit_inside.clear();h->audit_contacts.clear();}
+ ShowInfo("KT_FIELD %lld owner=%d group=%d src=%d level=%u center=%d,%d event=%s inside_seen=%zu hit_unique=%zu tracked=%d\n",(long long)gettick(),data.owner,g.group_id,g.src_id,g.skill_lv,data.x,data.y,begin?"begin":"end",h?h->audit_inside.size():0,h?h->audit_hits.size():0,int(h && h->audit_group==g.group_id));
+ if(!begin){
+  audit_fields.erase(it);
+  if(h && h->audit_group==g.group_id){h->audit_group=0;h->audit_inside.clear();h->audit_hits.clear();}
+ }
+}
+void kt_damage(const block_list* src,const block_list* dst,int skill,unsigned before,unsigned after){
+ int owner=kt_owner(dst);if(!owner || !src || before==after)return;
+ auto& h=hunts.at(owner);
+ auto it=shells.find(src->id);
+ bool sg=skill==WZ_STORMGUST && it!=shells.end() && it->second.character==unsigned(owner);
+ if(sg && h.audit_group)h.audit_hits.insert(dst->id);
+ ShowInfo("KT_HIT %lld owner=%d src=%d dst=%d skill=%d group=%d hp=%u->%u xy=%d,%d\n",(long long)gettick(),owner,src->id,dst->id,skill,sg?h.audit_group:0,before,after,dst->x,dst->y);
+}
+
+void kt_contact(int group,const block_list* mob){
+ if(!mob || mob->type!=BL_MOB)return;
+ auto it=audit_fields.find(group);if(it==audit_fields.end())return;
+ auto t=hunts.find(it->second.owner);if(t==hunts.end() || t->second.audit_group!=group)return;
+ if(!t->second.audit_contacts.insert(mob->id).second)return;
+ t->second.audit_inside.insert(mob->id);
+ ShowInfo("KT_CONTACT %lld group=%d id=%d xy=%d,%d\n",(long long)gettick(),group,mob->id,mob->x,mob->y);
+}
