+    const int y=job==JOB_KNIGHT?h.drop_y:h.y;
+    if(distance_xy(sd->x,sd->y,x,y)>(job==JOB_KNIGHT?1:3)){
+        unit_stop_attack(sd);
+        if(sd->ud.walktimer==INVALID_TIMER)walk_toward_cell(sd,h,x,y);
+        return;
+    }
+    if(h.retreat || pc_isdead(owner))return;
+    const bool add=!h.camp_target;
+    auto* mob=map_id2md(add?h.camp_add:h.camp_target);
+    if(!mob || !scout_sees(sd,mob) || !unclaimed(owner,mob))return;
+    const bool engaged=team_victim(mob,owner) || (h.hunter_hit_target==mob->id && h.hunter_hit_damage>0);
+    auto enabled=[&](const char* k){return std::find(shell.policy.skills.begin(),shell.policy.skills.end(),k)!=shell.policy.skills.end();};
+    if(job==JOB_KNIGHT){
+        if((!add || engaged) && mob->target_id!=sd->id && enabled("provoke") && cast_skill(shell,mob,SM_PROVOKE,5))return;
+    }else if(job==JOB_HUNTER){
+        if(!hunter_ready(shell,owner))return;
+        auto item=select_arrow(shell,status_get_status_data(*mob));
+        if(!item || !prepare_arrow(shell,item))return;
+        if(enabled("double") && cast_skill(shell,mob,AC_DOUBLE,1))return;
+    }else if(job==JOB_WIZARD){
+        if(!add && cast_build_ground(shell,mob))return;
+        if(add && engaged){
+            auto spell=choose_spell(shell,*status_get_status_data(*mob));
+            if(spell.skill)cast_skill(shell,mob,spell.skill,spell.level,true);
+        }
+        return;
+    }else return;
+    // One in-range swing/shot. A continuous native chase would leave camp.
+    if((!add || engaged) && sd->ud.attacktimer==INVALID_TIMER && battle_check_range(sd,mob,status_get_range(sd)))
+        unit_attack(sd,mob->id,0);
