+// This observer sees only the protected area and requires a living camp member's LOS.
+static bool camp_sighted(map_session_data* owner,const Hunt& h,const mob_data* mob){
+    for(const auto& kv:shells){
+        const auto& s=kv.second;
+        if(hunt_member(s,owner) && !pc_isdead(s.sd) &&
+           distance_xy(s.sd->x,s.sd->y,h.x,h.y)<=12 && scout_sees(s.sd,mob))return true;
+    }
+    return false;
+}
+static int observe_owner_delivery(block_list* bl,va_list ap){
+    auto* owner=va_arg(ap,map_session_data*);
+    auto& h=*va_arg(ap,Hunt*);
+    auto& delivered=*va_arg(ap,std::set<int>*);
+    auto* m=static_cast<mob_data*>(bl);
+    if(status_isdead(*m) || m->master_id || m->guardian_data || m->get_bosstype()!=BOSSTYPE_NONE ||
+       !camp_sighted(owner,h,m) || !unclaimed(owner,m))return 0;
+    const int gap=distance_xy(m->x,m->y,h.drop_x,h.drop_y);
+    const bool tagged=std::any_of(m->dmglog.begin(),m->dmglog.end(),[&](const auto& hit){return hit.id==owner->status.char_id && hit.dmg>0;});
+    if(m->target_id==owner->id || tagged || (h.pack.count(m->id) && team_victim(m,owner))){
+        delivered.insert(m->id);
+        if(!h.camp_target || m->id<h.camp_target)h.camp_target=m->id;
+    }else if(distance_xy(m->x,m->y,h.x,h.y)<=7 && (!h.camp_add || m->id<h.camp_add)){
+        h.camp_add=m->id;
+    }
+    return 0;
+}
+struct CampAuditCounts{int seen=0,aggro=0,inside=0;};
+static int count_observed_mob(block_list* bl,va_list ap){
+ auto* owner=va_arg(ap,map_session_data*);auto* h=va_arg(ap,Hunt*);
+ auto* c=va_arg(ap,CampAuditCounts*);auto* g=va_arg(ap,s_skill_unit_group*);
+ auto* m=static_cast<mob_data*>(bl);
+ if(status_isdead(*m) || !camp_sighted(owner,*h,m))return 0;
+ ++c->seen;if(m->target_id==owner->id)++c->aggro;
+ if(g)for(int i=0;i<g->unit_count;++i){
+  const auto& u=g->unit[i];
+  if(u.alive && distance_xy(m->x,m->y,u.x,u.y)<=u.range){++c->inside;h->audit_inside.insert(m->id);break;}
+ }
+ return 0;
+}
+static int count_player_view(block_list* bl,va_list ap){
+ auto* owner=va_arg(ap,map_session_data*);auto* c=va_arg(ap,CampAuditCounts*);
+ if(!status_isdead(*bl) && scout_sees(owner,bl)){++c->seen;if(static_cast<mob_data*>(bl)->target_id==owner->id)++c->aggro;}
+ return 0;
+}
+static void sample_owner_train(map_session_data* owner,Hunt& h){
+ auto now=gettick();if(now<h.audit_next)return;h.audit_next=now+1000;
+ CampAuditCounts camp,player;
+ auto g=h.audit_group?skill_id2group(h.audit_group):nullptr;
+ map_foreachinallarea(count_observed_mob,owner->m,h.x-26,h.y-26,h.x+26,h.y+26,BL_MOB,owner,&h,&camp,g.get());
+ map_foreachinallarea(count_player_view,owner->m,owner->x-14,owner->y-14,owner->x+14,owner->y+14,BL_MOB,owner,&player);
+ ShowInfo("KT_TRAIN %lld owner=%d pos=%d,%d dock=%d,%d player_visible=%d player_aggro=%d camp_visible=%d camp_aggro=%d registered=%zu field=%d inside_now=%d hit_unique=%zu\n",(long long)now,owner->status.char_id,owner->x,owner->y,h.drop_x,h.drop_y,player.seen,player.aggro,camp.seen,camp.aggro,h.pack.size(),h.audit_group,camp.inside,h.audit_hits.size());
+}
+
+static void observe_owner_camp(map_session_data* owner,Hunt& h){
+    std::set<int> delivered;
+    h.camp_target=h.camp_add=0;
+    map_foreachinallarea(observe_owner_delivery,owner->m,h.x-26,h.y-26,h.x+26,h.y+26,BL_MOB,owner,&h,&delivered);
+    if(h.pack.empty() && !delivered.empty()){h.storm_landed=false;h.mire_landed=false;}
+    if(h.pack.size()!=delivered.size() && gettick()>=h.scout_log_at){
+        h.scout_log_at=gettick()+1000;
+        ShowInfo("Mob wave B_OWNER_CAMP %lld anchor=%d,%d dock=%d,%d visible_train=%zu\n",(long long)gettick(),h.x,h.y,h.drop_x,h.drop_y,delivered.size());
+    }
+    h.pack.clear();h.pack.insert(delivered.begin(),delivered.end());
+    h.opened=h.release_pack=!h.pack.empty();h.hunter_target=h.camp_add;
+    h.round=h.opened?Hunt::Clear:Hunt::Ready;
+    sample_owner_train(owner,h);
+}
