+static void hold_owner_camp(Shell& shell,map_session_data* owner,Hunt& h){
+    auto* sd=shell.sd;
+    if(sd->ud.skilltimer!=INVALID_TIMER)return;
+    const auto job=companion_progression::career(sd->status.class_);
+    if(job==JOB_PRIEST && support_party(shell,owner))return;
+    if(job==JOB_WIZARD && !h.retreat && h.storm_target){if(auto* t=map_id2md(h.storm_target))cast_build_ground(shell,t);return;}
