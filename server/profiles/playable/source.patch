+// One booking per returning wave. Read only reports within a scout's current LOS.
+// The route belongs to the puller; the caster owns the committed native field.
+struct StormContact { int id,x,y,px,py,speed; };
+static void storm_meeting(map_session_data* owner,Hunt& h,t_tick now){
+    h.storm_target=0;
+    Shell *wizard=nullptr,*healer=nullptr;
+    for(auto& kv:shells){
+        auto& s=kv.second;
+        if(!hunt_member(s,owner)||pc_isdead(s.sd))continue;
+        if(s.build==companion_build::Build::storm)wizard=&s;
+        if(pc_checkskill(s.sd,AL_HEAL) && s.skills && std::find(s.policy.skills.begin(),s.policy.skills.end(),"heal")!=s.policy.skills.end() &&
+           s.sd->battle_status.sp>=skill_get_sp(AL_HEAL,companion_loadout::cast_level(s.sd,AL_HEAL,5)) &&
+           (!healer || camp_priest(s,owner)))healer=&s;
+    }
+    if(!wizard || h.retreat)return;
+    auto* w=wizard->sd;
+    auto* puller=h.owner_pull?owner:map_id2sd(h.opener);
+    if(!puller)return;
+    bool casting=w->ud.skilltimer!=INVALID_TIMER && w->ud.skill_id==WZ_STORMGUST;
+    if(casting || h.audit_group){
+        if(now>=h.storm_log){
+            h.storm_log=now+1000;
+            ShowInfo("Mob wave SG_HOLD %lld group=%d center=%d,%d puller=%d at=%d,%d heal_range=%d hp=%u\n",
+                 (long long)now,h.audit_group,h.book_x,h.book_y,puller->id,puller->x,puller->y,
+                 healer && battle_check_range(healer->sd,puller,skill_get_range2(healer->sd,AL_HEAL,1,true)),puller->battle_status.hp);
+        }
+        h.drop_x=h.book_x;h.drop_y=h.book_y;
+        return;
+    }
+    auto note=[&](const char* why,int count,int first,int tail,int cast){
+        if(now<h.storm_log && h.storm_reason==why)return;
+        h.storm_log=now+2000;h.storm_reason=why;
+        ShowInfo("Mob wave SG_PLAN %lld role=%s center=%d,%d seen=%d first_ms=%d tail_ms=%d cast_ms=%d reason=%s\n",
+           (long long)now,h.owner_pull?"owner":h.priest_pull?"priest":"knight",h.drop_x,h.drop_y,count,first,tail,cast,why);
+    };
+    if(!healer){note("heal-unavailable",0,-1,-1,0);return;}
+    if(h.owner_pull && !battle_check_range(healer->sd,owner,skill_get_range2(healer->sd,AL_HEAL,1,true)) && now>=h.help_notice){
+        mob_message(owner,h,"เจ้าของอยู่นอกระยะ Heal ของค่าย");h.help_notice=now+12000;
+    }
+    if(!h.owner_pull && !h.release_pack && h.round!=Hunt::Clear)return;
+    int cast=storm_cast_preview(w);
