+// Compare learned ranks on the same monsters. Use expected HP removed to break
+// ties on kills before preferring the faster rank. This estimate has no RNG.
+static uint16 storm_rank(Shell& wizard,const Hunt& h,mob_data& focus,uint16 max_level) {
+    const auto& caster=wizard.sd->battle_status;
+    uint16 chosen=0;
+    double best=-1;
+    for(uint16 level=1;level<=max_level;++level){
+        if(!can_spend_sp(wizard,WZ_STORMGUST,level))continue;
+        double value=0;
+        for(int id:h.pack){
+            auto* m=map_id2md(id);
+            if(!m || !m->status.hp || distance_bl(&focus,m)>5)continue;
+            const auto& st=m->status;
+            const double resistance=(1000.+st.mdef)/(1000.+10.*std::max<int>(0,st.mdef));
+            const int element=elemental_attribute_db.getAttribute(st.ele_lv,ELE_WATER,st.def_ele);
+            const double hit=std::max(1.,(caster.matk_min+caster.matk_max)*.5*(.7+.5*level)*resistance-st.mdef2)
+                *std::max(0,element)/100.;
+            const int hits=battle_check_undead(st.race,st.def_ele) || status_has_mode(&m->status,MD_STATUSIMMUNE)?10:3;
+            const double fraction=hit*hits/st.hp;
+            value+=(fraction>=1.?1.:0.)+std::min(1.,fraction)*.25;
+        }
+        if(value>best){best=value;chosen=level;}
+    }
+    return chosen;
+}
